@app.route('/analysis')
def analysis():
    try:
        sym = request.args.get('symbol','EURUSDm'); tf_str = request.args.get('tf','1')
        mt5.symbol_select(sym, True); tick = mt5.symbol_info_tick(sym)
        if not tick: return jsonify({"ok": False})
        closes = []
        if hasattr(mt5, 'copy_rates'):
            tf = TF_MAP.get(tf_str, mt5.TIMEFRAME_M1)
            rates = mt5.copy_rates(sym, tf, 0, 100)
            if rates is not None and len(rates) >= 30: closes = [r['close'] for r in rates]
        if not closes:
            key = f"{sym}_{tf_str}"
            if key not in price_history: price_history[key] = deque(maxlen=200)
            price_history[key].append(tick.bid); closes = list(price_history[key])
        if len(closes) < 26:
            return jsonify({"ok": True, "price": tick.bid, "ema9": tick.bid, "ema21": tick.bid, "rsi": 50, "macd": 0, "macd_signal": 0, "bb_upper": tick.bid, "bb_lower": tick.bid, "bb_mid": tick.bid, "tendencia": "COLETANDO", "forca": f"{len(closes)}/26", "sinal": "AGUARDAR", "confianca": 0, "detalhes": "Coletando..."})
        ema9 = ema_calc(closes, 9); ema21 = ema_calc(closes, 21); ema12 = ema_calc(closes, 12); ema26 = ema_calc(closes, 26)
        macd_line = ema12 - ema26
        macd_series = []
        for i in range(26, len(closes)):
            e12 = ema_calc(closes[:i], 12); e26 = ema_calc(closes[:i], 26); macd_series.append(e12 - e26)
        macd_signal = ema_calc(macd_series, 9) if len(macd_series) >= 9 else macd_line
        sma20 = sma_calc(closes, 20); std20 = std_calc(closes, 20)
        bb_upper = sma20 + (std20 * 2); bb_lower = sma20 - (std20 * 2)
        gains=0; losses=0
        for i in range(1, 15):
            if len(closes) > i:
                diff = closes[-i] - closes[-i-1]
                if diff>0: gains+=diff
                else: losses+=-diff
        rsi = 100 - (100/(1+(gains/(losses if losses!=0 else 1)))) if losses!=0 else 70
        tendencia = "ALTA" if ema9>ema21 else "BAIXA"
        pontos_call = 0; pontos_put = 0
        if ema9 > ema21: pontos_call += 1
        else: pontos_put += 1
        if macd_line > macd_signal: pontos_call += 1
        else: pontos_put += 1
        if rsi < 35: pontos_call += 1
        elif rsi > 65: pontos_put += 1
        if closes[-1] <= bb_lower: pontos_call += 1.5
        elif closes[-1] >= bb_upper: pontos_put += 1.5
        sinal = "AGUARDAR"; conf = 50
        if pontos_call >= 3: sinal = "CALL"; conf = 60 + (pontos_call*10)
        elif pontos_put >= 3: sinal = "PUT"; conf = 60 + (pontos_put*10)
        conf = min(95, int(conf))
        detalhes = []
        if ema9>ema21: detalhes.append("EMA Alta")
        else: detalhes.append("EMA Baixa")
        if macd_line>macd_signal: detalhes.append("MACD Alta")
        else: detalhes.append("MACD Baixa")
        if rsi<30: detalhes.append("RSI Fundo")
        elif rsi>70: detalhes.append("RSI Topo")
        if closes[-1]<=bb_lower: detalhes.append("BB Fundo")
        elif closes[-1]>=bb_upper: detalhes.append("BB Topo")
        return jsonify({"ok": True, "price": float(tick.bid), "ema9": float(ema9), "ema21": float(ema21), "rsi": round(rsi,1), "macd": round(macd_line,6), "macd_signal": round(macd_signal,6), "bb_upper": float(bb_upper), "bb_lower": float(bb_lower), "bb_mid": float(sma20), "tendencia": tendencia, "forca": f"C{pontos_call}xP{pontos_put}", "sinal": sinal, "confianca": conf, "detalhes": ", ".join(detalhes)})
    except Exception as e:
        print(f"ERRO: {e}"); return jsonify({"ok": False})
@app.route('/trade', methods=['POST'])
def trade():
    data = request.json; action = data.get('action'); symbol = data.get('symbol','EURUSDm'); lot = float(data.get('lot',0.05))
    mt5.symbol_select(symbol, True); tick = mt5.symbol_info_tick(symbol)
    price = tick.ask if action=='buy' else tick.bid
    type_order = mt5.ORDER_TYPE_BUY if action=='buy' else mt5.ORDER_TYPE_SELL
    req = {"action": mt5.TRADE_ACTION_DEAL, "symbol": symbol, "volume": lot, "type": type_order, "price": price, "deviation": 50, "magic": 234000, "comment": "JARVIS V6", "type_time": mt5.ORDER_TIME_GTC, "type_filling": mt5.ORDER_FILLING_IOC}
    result = mt5.order_send(req)
    if result and result.retcode==mt5.TRADE_RETCODE_DONE: return jsonify({"ok": True, "ticket": result.order})
    return jsonify({"ok": False, "error": result.comment if result else "erro"}), 400
@app.route('/close', methods=['POST'])
def close():
    ticket=int(request.json.get('ticket')); pos = mt5.positions_get(ticket=ticket)
    if not pos: return jsonify({"ok": False})
    p=pos[0]; tipo = mt5.ORDER_TYPE_SELL if p.type==0 else mt5.ORDER_TYPE_BUY
    tick = mt5.symbol_info_tick(p.symbol); price = tick.bid if p.type==0 else tick.ask
    req={"action": mt5.TRADE_ACTION_DEAL, "position": p.ticket, "symbol": p.symbol, "volume": p.volume, "type": tipo, "price": price, "deviation": 50, "magic": 0, "comment": "close", "type_time": mt5.ORDER_TIME_GTC, "type_filling": mt5.ORDER_FILLING_IOC}
    res=mt5.order_send(req)
    if res and res.retcode==mt5.TRADE_RETCODE_DONE: return jsonify({"ok": True})
    return jsonify({"ok": False, "error": res.comment if res else "erro"}), 400
