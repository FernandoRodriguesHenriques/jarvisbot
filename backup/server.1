def ema_calc(data, period):
    if not data or len(data) < period: return data[-1] if data else 0
    k = 2/(period+1); e = sum(data[:period])/period
    for price in data[period:]: e = price*k + e*(1-k)
    return e
def sma_calc(data, period):
    if len(data) < period: return sum(data)/len(data) if data else 0
    return sum(data[-period:])/period
def std_calc(data, period):
    if len(data) < period: return 0
    sma = sma_calc(data, period); var = sum((x - sma)**2 for x in data[-period:]) / period
    return math.sqrt(var)

def enviar_whatsapp(mensagem):
    try:
        import requests
        msg_encoded = urllib.parse.quote(mensagem)
        url = f"https://api.callmebot.com/whatsapp.php?phone={ZAP_PHONE}&text={msg_encoded}&apikey={ZAP_APIKEY}"
        r = requests.get(url, timeout=15)
        print(f"ZAP RESPOSTA: {r.text}")
        return "queued" in r.text or "sent" in r.text.lower()
    except Exception as e:
        print(f"Zap erro: {e}")
        return False

def get_today_deals():
    hoje = datetime.datetime.now().replace(hour=0,minute=0,second=0)
    deals = mt5.history_deals_get(hoje, datetime.datetime.now())
    return deals if deals else []
def calcular_lucro_hoje():
    deals = get_today_deals()
    lucro = 0.0; wins = 0; losses = 0
    for d in deals:
        if d.type in [0,1]:
            lucro += d.profit + d.swap
            if d.profit > 0: wins += 1
            elif d.profit < 0: losses += 1
    return lucro, wins, losses, len(deals)
def gerar_relatorio():
    acc = mt5.account_info()
    lucro_hoje, wins, losses, total = calcular_lucro_hoje()
    saldo = acc.balance if acc else 0
    agora = datetime.datetime.now().strftime("%d/%m/%Y %H:%M")
    taxa = (wins/total*100) if total>0 else 0
    rel = f"\n========== RELATORIO JARVIS - {agora} ==========\nSaldo: ${saldo:.2f}\nLucro Hoje: ${lucro_hoje:.2f}\nTrades: {total} (W:{wins}/L:{losses}) Taxa: {taxa:.1f}%\n=============================================\n"
    print(rel)
    try:
        with open(REPORT_FILE, "a", encoding="utf-8") as f: f.write(rel)
    except: pass
    msg_zap = f"🤖 *JARVIS 12h* - {agora}\n\n💰 Saldo: ${saldo:.2f}\n📊 Hoje: ${lucro_hoje:.2f}\n📈 Trades: {total} (W:{wins}/L:{losses})\n✅ Taxa: {taxa:.1f}%"
    enviar_whatsapp(msg_zap)
    return rel

def scheduler_relatorio():
    ja_enviou = None
    while True:
        agora = datetime.datetime.now()
        if agora.hour == REPORT_HOUR and agora.minute == 0:
            if ja_enviou!= agora.date():
                gerar_relatorio()
                ja_enviou = agora.date()
                time.sleep(60)
        time.sleep(30)
threading.Thread(target=scheduler_relatorio, daemon=True).start()

